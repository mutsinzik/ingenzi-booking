# ============ Frontend-safe (safe to expose in browser bundle) ============
# These are public and shipped in the frontend. They grant only anon-level
# access — RLS policies enforce what anon can actually do.

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (public by design — RLS protects your data)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============ Supabase Edge Function secrets (NEVER in frontend code) ============
# Set these in the Supabase dashboard:
#   Edge Functions → Secrets (or via the Supabase MCP secrets tools)
# They are read with Deno.env.get() inside the Edge Functions only.

# Brevo (transactional email) API key
# Get this from https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key

# Brevo verified sender email (must be verified in Brevo dashboard)
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Brevo sender display name
BREVO_SENDER_NAME=Court Bookings

# Public URL of your deployed site (used in email links)
SITE_URL=https://your-site-url.com
